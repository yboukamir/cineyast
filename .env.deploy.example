# Copiez ce fichier en `.env.deploy` (jamais commité) pour `npm run deploy`.
# Identifiants FTP visibles dans votre espace client LWS > Hébergement > FTP.
FTP_HOST=ftp.cineyast.com
FTP_USER=
FTP_PASSWORD=
# Dossier racine du site sur l'hébergement (souvent /htdocs ou /public_html chez LWS)
FTP_REMOTE_DIR=/htdocs
# true = FTPS (recommandé si l'hébergement le propose)
FTP_SECURE=true
