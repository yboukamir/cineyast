# Cinéyast — configuration Apache pour l'hébergement LWS

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── HTTPS forcé ───────────────────────────────────────────────────────────
  # Décommentez les 3 lignes suivantes UNIQUEMENT après avoir activé le
  # certificat SSL (Let's Encrypt gratuit) dans le panneau LWS, sinon le site
  # deviendra inaccessible.
  # RewriteCond %{HTTPS} !=on
  # RewriteCond %{HTTP:X-Forwarded-Proto} !https
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ── Application monopage (React Router) ──────────────────────────────────
  # Fichiers et dossiers réels (assets, api/tmdb.php…) servis tels quels ;
  # toute autre URL (/film/550, /explorer…) renvoie index.html.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

# ── Compression ─────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# ── Cache navigateur ────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Fichiers de build versionnés par hash : cache d'un an.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # La page HTML doit toujours être revalidée pour récupérer les nouveaux assets.
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>

  # ── En-têtes de sécurité ──────────────────────────────────────────────────
  # Garder la CSP identique à server/security-headers.ts.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://image.tmdb.org https://i.ytimg.com; font-src 'self' data:; connect-src 'self'; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
